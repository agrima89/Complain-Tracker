# ==============================================================================
# CampusCare — Netlify Serverless Application Environment Configuration
# ==============================================================================

# Netlify Database / PostgreSQL Connection URL (Provided automatically when you connect Netlify Database)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
NETLIFY_DB_URL=postgresql://neondb_owner:npg_example@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative alias supported:
# DATABASE_URL=postgresql://...

# Secure JWT Session Signing Secret (Required in production)
JWT_SECRET=campuscare_super_secure_jwt_secret_key_2026_prod

# Super Admin Initialization Password (Used during initial setup if admins table is empty)
ADMIN_PASSWORD=AdminSecurePass2026!

# Escalation Threshold (Hours before unresolved high-priority complaints flag for attention)
ESCALATION_HOURS_THRESHOLD=48

# Maximum File Upload Size in Megabytes (Default: 16 MB)
MAX_CONTENT_LENGTH_MB=16

# Node Environment
NODE_ENV=production
