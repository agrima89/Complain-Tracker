# ==============================================================================
# CampusCare — Student Complaint & Solution Tracker Environment Configuration
# Copy this file to .env and adjust variables as needed for local/production setup
# ==============================================================================

# Flask Session & CSRF Secret Key
SECRET_KEY=campuscare_secure_secret_key_2026_cse_project

# SQLite Database Location (Absolute or relative path)
DATABASE_PATH=database.db

# Escalation Threshold (Hours before unresolved high-priority complaints flag for attention)
ESCALATION_HOURS_THRESHOLD=48

# Maximum File Upload Size in Megabytes (Default: 16 MB)
MAX_CONTENT_LENGTH_MB=16

# Server Port and Host
PORT=5000
HOST=127.0.0.1
